+  color: var(--ok, #2d8c5b);
+  font-weight: 600;
+}
+.ob-hub-topo-node[data-topo-state="pending"] .ob-hub-topo-sub {
+  color: var(--warn, #b27110);
+  font-weight: 600;
+}
+.ob-hub-topo-link {
+  color: var(--text-3, #8a8f98);
